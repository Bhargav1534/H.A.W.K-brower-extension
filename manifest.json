{
  "manifest_version": 3,
  "name": "Hawk Browser Monitor",
  "version": "2.6.9",

  "permissions": [
    "tabs",
    "activeTab",
    "webNavigation",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "web_accessible_resources": [
    {
      "resources": ["config.local.json", "assets/send_icon.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "readability.js"],
      "run_at": "document_end",
      "type": "module"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "assets/hawk_logo.png"
    }
  }
}
